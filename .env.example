# Perplexity API Key
# Get your API key from: https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=your_perplexity_api_key_here

# Optional: Server port (defaults to 3000)
PORT=3000

# Optional: Perplexity model name (defaults to sonar)
# Common models: sonar, sonar-pro, sonar-reasoning, sonar-reasoning-pro
PERPLEXITY_MODEL=sonar

# Optional: Set to 'false' if Perplexity doesn't support system messages
# USE_SYSTEM_MESSAGE=true
